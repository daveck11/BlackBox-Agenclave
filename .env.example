# Copy to .env and fill in. NEVER commit .env.
# Stage 1 (classifier training, API, demo) needs NO keys.
# Keys are only used by the Stage 2 Chairman harness when calling live providers.

# --- Direct provider adapter (Stage 2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Gateways (optional): BlackBox or OpenRouter, same OpenAI-compatible protocol ---
# BlackBox closed self-serve API keys in October 2026 (enterprise only), so
# OpenRouter is the working fallback. Model ids are provider/model on both.
BLACKBOX_API_KEY=
AGENCLAVE_BLACKBOX_API_BASE=https://enterprise.blackbox.ai/v1
OPENROUTER_API_KEY=
AGENCLAVE_OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Harness configuration (overridable; see src/agenclave/config.py) ---
# Provider backend: "direct" (Claude/OpenAI by name), "blackbox" or "openrouter"
# (everything through that gateway - agents AND the Chairman judge).
AGENCLAVE_PROVIDER=direct

# DIRECT example:
AGENCLAVE_AGENT_MODELS=claude-sonnet-4-6,gpt-4o-mini
AGENCLAVE_CHAIRMAN_MODEL=claude-opus-4-8

# GATEWAY example (set AGENCLAVE_PROVIDER=openrouter or blackbox; the open-source
# fleet the reliability store was learned on, with a gpt-oss-120b judge):
# AGENCLAVE_AGENT_MODELS=deepseek/deepseek-v4-pro,nvidia/nemotron-3-nano-30b-a3b,mistralai/devstral-2512,moonshotai/kimi-k2.7-code
# AGENCLAVE_CHAIRMAN_MODEL=openai/gpt-oss-120b
