# Copy to .env and fill in. NEVER commit .env.
# Stage 1 (classifier training, API, demo) needs NO keys.
# Keys are only used by the Stage 2 Chairman harness when calling live providers.

# --- Direct provider adapter (Stage 2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- BlackBox AI (optional) ---
# OpenAI-compatible API: one key reaches every model in the catalogue.
# api.blackbox.ai no longer answers; the quickstart host is enterprise.blackbox.ai.
BLACKBOX_API_KEY=
AGENCLAVE_BLACKBOX_API_BASE=https://enterprise.blackbox.ai/v1

# --- Harness configuration (overridable; see src/agenclave/config.py) ---
# Provider backend: "direct" (Claude/OpenAI by name) or "blackbox" (everything
# through BlackBox's API - agents AND the Chairman judge).
AGENCLAVE_PROVIDER=direct

# DIRECT example:
AGENCLAVE_AGENT_MODELS=claude-sonnet-4-6,gpt-4o-mini
AGENCLAVE_CHAIRMAN_MODEL=claude-opus-4-8

# BLACKBOX example (set AGENCLAVE_PROVIDER=blackbox; ids are blackboxai/<provider>/<model>,
# confirm against your account's GET /models):
# AGENCLAVE_AGENT_MODELS=blackboxai/anthropic/claude-sonnet-4.6,blackboxai/openai/gpt-5.4,blackboxai/google/gemini-3.1-flash-lite,blackboxai/deepseek/deepseek-v4-pro
# AGENCLAVE_CHAIRMAN_MODEL=blackboxai/anthropic/claude-opus-4.7
